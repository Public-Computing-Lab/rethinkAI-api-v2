# Unified environment configuration for rethinkAI-API-v2

# ============================================
# ENVIRONMENT TOGGLE: "local" or "production"
# ============================================
ENVIRONMENT=local

# ============================================
# Base paths (change these per environment)
# ============================================
LOCAL_BASE_PATH=<local_environment_path>
PROD_BASE_PATH=<production_environment_path>

# ============================================================================
# Gemini AI Configuration
# ============================================================================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Embedding model for vector search (RAG)
GEMINI_EMBED_MODEL=gemini-embedding-001

# ============================================================================
# API / Flask / WebApp configuration
# ============================================================================

API_VERSION=2.1
RETHINKAI_API_KEYS=
RETHINKAI_API_KEY=

PROD_API_HOST=
PROD_API_PORT=
PROD_API_BASE_URL=
PROD_API_TIMEOUT_MS=30000
PROD_FLASK_SECRET_KEY=
PROD_FLASK_SESSION_COOKIE_SECURE=True

LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=8888
LOCAL_API_BASE_URL=http://127.0.0.1:8888
LOCAL_API_TIMEOUT_MS=30000
LOCAL_FLASK_SECRET_KEY=testableBananas
LOCAL_FLASK_SESSION_COOKIE_SECURE=False

# ============================================================================
# MySQL Database Configuration (311, 911, events)
# ============================================================================

PROD_MYSQL_HOST=<mysql.host.com>
PROD_MYSQL_PORT=3306
PROD_MYSQL_USER=
PROD_MYSQL_PASSWORD=
PROD_MYSQL_DB=

PROD_MYSQL_MAX_RETRIES=3
PROD_MYSQL_POOL_SIZE=10
PROD_MYSQL_POOL_RECYCLE=3600

LOCAL_MYSQL_HOST=127.0.0.1
LOCAL_MYSQL_PORT=3306
LOCAL_MYSQL_USER=
LOCAL_MYSQL_PASSWORD=
LOCAL_MYSQL_DB=

LOCAL_MYSQL_MAX_RETRIES=3
LOCAL_MYSQL_POOL_SIZE=5
LOCAL_MYSQL_POOL_RECYCLE=3600

# ============================================================================
# Data Ingestion (Google Drive + Email)
# ============================================================================

GOOGLE_DRIVE_FOLDER_ID=
NEWSLETTER_EMAIL_ADDRESS=
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

EMAIL_LOOKBACK_DAYS=7
MAX_FILES_PER_RUN=100
LLM_MAX_WORKERS=5

# ============================================================================
# Data URLs:
# Boston 311 data portal
# Dotnews (Dorchester Reporter
# ============================================================================

BOSTON_CKAN_API=https://data.boston.gov/api/3/action

# ============================================================================
# Article Ingestion options
# ============================================================================

# Enable/disable article extraction (events always extracted)
EXTRACT_ARTICLES=true
# Minimum word count for articles (skip very short snippets)
ARTICLE_MIN_LENGTH=50