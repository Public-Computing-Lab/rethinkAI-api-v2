# === IDE / Editor ===
.nova/
.vscode/
.idea/
*.swp
*.swo
*.sublime-*
.flake8
.vercelignore

# === OS Generated ===
.DS_Store
Thumbs.db
desktop.ini

# === Python ===
__pycache__/
*.py[cod]
*.pyd
venv/
.venv/
*.egg-info/
pip-log.txt

# === Environment & Secrets ===
.env*
!.env.example
config.json
secrets.json
credentials/*
!credentials/.gitkeep

# === Logs & State ===
logs/*
!logs/.gitkeep
*.log
*.jsonl
data/.sync*

# === Databases ===
*.sqlite
*.sqlite3
*.db

# === Vector DB (large binary data) ===
vectordb/

# === Node.js ===
node_modules/
npm-debug.log*
dist/
build/

# === Data directories (with exceptions) ===
**/cache/*
**/data/*
!**/cache/.gitkeep
!**/data/.gitkeep
api/datastore/*
!api/datastore/.gitkeep
data/*

# === Flask / Gunicorn ===
instance/
*.pid
*.sock

# === Jupyter ===
.ipynb_checkpoints/

# === Build / Temp ===
*.bak
*.tmp
*.whl
structure.txt

# === Project-specific config (generated at runtime) ===
public/config.js